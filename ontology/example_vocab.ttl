@prefix exv:  <https://example.org/vocab/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# SYNTHETIC vocabulary snapshot for the example only (example.org, not a real thesaurus).
# A real export does not contain this part: the vocabulary stays with its publisher and is
# referenced via dct:requires.  Load it next to an export when you want labels and
# descendant queries (queries.rq, Q2) to work.

exv:scheme a skos:ConceptScheme ;
    dcat:version "2026-10-01" ;
    dct:source <https://example.org/vocab/> ;
    dct:issued "2026-10-15"^^xsd:date .
exv:Material a skos:Concept ; skos:prefLabel "Material"@en ; skos:inScheme exv:scheme .
exv:AnimalMaterial a skos:Concept ; skos:prefLabel "animal material"@en ; skos:broader exv:Material ; skos:inScheme exv:scheme .
exv:CollagenousMaterial a skos:Concept ; skos:prefLabel "collagenous material"@en ; skos:broader exv:AnimalMaterial ; skos:inScheme exv:scheme .
exv:AnimalSkin a skos:Concept ; skos:prefLabel "animal skin"@en ; skos:broader exv:CollagenousMaterial ; skos:inScheme exv:scheme .
exv:Leather a skos:Concept ; skos:prefLabel "leather"@en ; skos:broader exv:AnimalSkin ; skos:inScheme exv:scheme .
exv:Textile a skos:Concept ; skos:prefLabel "textile"@en ; skos:broader exv:Material ; skos:inScheme exv:scheme .
exv:Damage a skos:Concept ; skos:prefLabel "Damage"@en ; skos:inScheme exv:scheme .
exv:Crack a skos:Concept ; skos:prefLabel "crack"@en ; skos:broader exv:Damage ; skos:inScheme exv:scheme .
exv:Abrasion a skos:Concept ; skos:prefLabel "abrasion"@en ; skos:broader exv:Damage ; skos:inScheme exv:scheme .
exv:Intervention a skos:Concept ; skos:prefLabel "Intervention"@en ; skos:inScheme exv:scheme .
